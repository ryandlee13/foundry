# Copy this file to .env.local and fill in real values from your Supabase project
# settings (Project Settings -> API). Never commit .env.local or any file containing
# real credentials.

# Public — safe to expose to the browser. Found in Supabase Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-only. Bypasses Row Level Security entirely. Must never be prefixed
# with NEXT_PUBLIC_, referenced from a Client Component, or committed to source control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this app. Used for building absolute links (e.g. auth redirects, signed
# URL callbacks). Use http://localhost:3000 for local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public — optional. Enables a live interactive map on /spaces. Without it, the
# Discover Spaces location picker falls back to a curated list of San Francisco
# neighborhoods/ZIP codes and a static radius preview — the page still works fully.
NEXT_PUBLIC_MAPBOX_TOKEN=
